# 数据库连接字符串（必需）
DATABASE_URL=postgresql://user:password@host:5432/database

# 飞书 Webhook URL（用于发送管理员监控通知）
# 在飞书群组中添加自定义机器人获取
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# Brevo 邮件 API 配置（用于发送用户邮件通知）
# 从 https://app.brevo.com/settings/keys/api 获取
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=noreply@guardssl.info
BREVO_SENDER_NAME=GuardSSL

# 品牌配置（用于邮件模板）
BRAND_NAME=Guard SSL
BRAND_URL=https://guardssl.info
DASHBOARD_URL=https://guardssl.info/dashboard

# SSL 检查超时时间（秒，可选）
SSL_CHECK_TIMEOUT=10

# 重试配置（可选）
MAX_RETRIES=3
RETRY_DELAY=2

# 证书过期预警天数（可选，默认 30 天）
EXPIRING_THRESHOLD_DAYS=30
